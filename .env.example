# ============================================================
# VocaRAG v2.0 Configuration Template
# ============================================================

# LLM Provider: groq | gemini | openai | demo
LLM_PROVIDER=groq

# Groq LPU Fast-Path (Recommended for sub-250ms generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Sarvam AI STT (Saaras v3 - 23 Indic Languages)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v3
SARVAM_DEFAULT_LANGUAGE=hi-IN

# Multilingual Indic Dense Embedding Model (768-dim)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2

# MSMARCO-XI Multilingual Corpus Ingestion
MSMARCO_ENABLED=true
MSMARCO_LANGUAGES=hi,te,en
MSMARCO_SLICE_SIZE_HI=1000
MSMARCO_SLICE_SIZE_TE=500
MSMARCO_SLICE_SIZE_EN=300

# Default RAG Collection (msmarco | enterprise)
DEFAULT_COLLECTION=msmarco

# Server Configuration
HOST=0.0.0.0
PORT=8000
